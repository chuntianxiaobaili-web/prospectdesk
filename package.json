    "./mock": "./src/mock.js",
    "./browser": "./src/local-browser.js",
    "./browser-mail": "./src/browser-mail/index.mjs",
    "./browser-mail/edge": "./src/browser-mail/edge.mjs",
    "./browser-mail/chrome": "./src/browser-mail/chrome.mjs",
    "./browser-mail/yandex": "./src/browser-mail/yandex.mjs",
