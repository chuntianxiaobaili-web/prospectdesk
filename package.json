    "local": "node src/local-app.js",
    "browser:edge": "node src/browser-mail/desktop-cli.mjs open --browser edge",
    "browser:chrome": "node src/browser-mail/desktop-cli.mjs open --browser chrome",
    "browser:yandex": "node src/browser-mail/desktop-cli.mjs open --browser yandex"
